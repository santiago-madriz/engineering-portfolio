---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import ProjectCard from '../components/ProjectCard.astro';
const base = import.meta.env.BASE_URL;
---
<BaseLayout>
  <section class="hero">
    <div class="hero-copy" data-reveal>
      <span class="availability"><span class="status-dot"></span> Costa Rica · Available for opportunities</span>
      <h1>Software built with <em>quality in the system.</em></h1>
      <p>I’m Santiago, a Software Engineer with Quality Engineering expertise. I build, test, and explain reliable production systems from the API to the user experience.</p>
      <div class="hero-actions">
        <a class="button" href={`${base}projects`}>View selected work <Icon name="arrow" /></a>
        <a class="button secondary" href="https://github.com/santiago-madriz" target="_blank" rel="noopener"><Icon name="github" /> GitHub</a>
      </div>
      <ul class="hero-proof">
        <li><Icon name="check" /> Development</li>
        <li><Icon name="check" /> Test architecture</li>
        <li><Icon name="check" /> Production readiness</li>
      </ul>
    </div>
    <div class="system-visual" aria-label="A three-step engineering workflow from design through validation to delivery" data-reveal>
      <div class="connector a"></div><i class="connector-dot a"></i>
      <div class="connector b"></div><i class="connector-dot b"></i>
      <div class="system-card one">
        <div class="window-bar"><i></i><i></i><i></i><span></span></div>
        <div class="card-step">01 · DESIGN</div><strong>Build the right system</strong><p>Clear boundaries, useful constraints, maintainable code.</p>
      </div>
      <div class="system-card two">
        <div class="card-step">02 · VERIFY</div><strong>Test where risk lives</strong>
        <ul><li>API contracts</li><li>User journeys</li><li>Access control</li><li>Failure paths</li></ul>
      </div>
      <div class="system-card three">
        <div class="card-step">03 · OPERATE</div><strong>Ship with confidence</strong><p>CI gates, observable behavior, production feedback.</p>
      </div>
    </div>
  </section>

  <section class="section" id="work">
    <div class="section-heading" data-reveal>
      <span class="eyebrow">Selected systems</span>
      <div><h2>Real work, <em>deliberately engineered.</em></h2><p>A small set of projects chosen to show product thinking, software development, and a quality strategy that goes beyond happy-path automation.</p></div>
    </div>
    <div class="project-grid">
      <ProjectCard number="01" label="Product system" title="Techy" description="A real commerce experience for Apple products in Costa Rica, now entering a private modernization phase with a public-safe engineering story." tags={['Next.js', 'TypeScript', 'Sanity']} href={`${base}projects/techy`} featured />
      <ProjectCard number="02" label="Quality platform" title="Playwright Quality Engineering" description="Risk-based UI, API, accessibility, performance, and cross-browser coverage organized as a production-style test system." tags={['Playwright', 'TypeScript', 'CI/CD']} href={`${base}projects/playwright-quality-engineering`} />
      <ProjectCard number="03" label="Production frontend" title="Photo & Film Portfolio" description="An owned, media-heavy production site with bilingual UX, accessibility gates, responsive behavior, and automated release checks." tags={['Web', 'A11y', 'Playwright']} href={`${base}projects/photography-platform`} />
    </div>
  </section>

  <section class="section method" data-reveal>
    <div>
      <span class="eyebrow">How I work</span>
      <h2>Quality is not a final step. <em>It shapes the architecture.</em></h2>
      <p>My QA background changes how I write software: I look for observable boundaries, explicit failure behavior, testable contracts, and delivery signals from the beginning.</p>
    </div>
    <div class="principles">
      <div class="principle"><Icon name="layers" /><div><strong>Design for change</strong><span>Small boundaries, documented decisions, and intentional tradeoffs.</span></div></div>
      <div class="principle"><Icon name="code" /><div><strong>Automate meaningful risk</strong><span>Tests exist to protect behavior, not inflate a coverage number.</span></div></div>
      <div class="principle"><Icon name="pulse" /><div><strong>Operate what ships</strong><span>Delivery, health, logs, and feedback are part of the product.</span></div></div>
    </div>
  </section>

  <section class="section">
    <div class="cta-band" data-reveal>
      <span class="eyebrow">Build · Test · Deliver</span>
      <h2>Looking for an engineer who cares how software behaves in the real world?</h2>
      <p>I’m interested in software engineering and quality engineering roles where reliability, product judgment, and hands-on delivery matter.</p>
      <a class="button" href="mailto:santiagomadrizc@gmail.com">Start a conversation <Icon name="arrow" /></a>
    </div>
  </section>
</BaseLayout>
