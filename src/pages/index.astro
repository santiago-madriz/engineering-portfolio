---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import LaptopModel from '../components/LaptopModel.astro';
import ProjectCard from '../components/ProjectCard.astro';
const base = import.meta.env.BASE_URL;
---
<BaseLayout>
  <section class="hero">
    <div class="hero-copy" data-reveal>
      <h1>Software built with <em>quality in the system.</em></h1>
      <p>I’m Santiago, a Software Engineer with Quality Engineering expertise. I build, test, and explain reliable production systems from the API to the user experience.</p>
      <div class="hero-actions">
        <a class="button" href={`${base}projects`}>View selected work <Icon name="arrow" /></a>
        <a class="button secondary" href="https://github.com/santiago-madriz" target="_blank" rel="noopener"><Icon name="github" /> GitHub</a>
        <LaptopModel />
      </div>
      <ul class="hero-proof">
        <li><Icon name="check" /> Development</li>
        <li><Icon name="check" /> Test architecture</li>
        <li><Icon name="check" /> Production readiness</li>
      </ul>
    </div>
    <div class="system-visual" aria-label="A three-step engineering workflow" data-reveal>
      <div class="connector a"></div><i class="connector-dot a"></i>
      <div class="connector b"></div><i class="connector-dot b"></i>
      <div class="system-card one">
        <div class="window-bar"><i></i><i></i><i></i><span></span></div>
        <div class="card-step">01 · DESIGN</div><strong>Build the right system</strong><p>Clear boundaries, useful constraints, maintainable code.</p>
      </div>
      <div class="system-card two">
        <div class="card-step">02 · VERIFY</div><strong>Test where risk lives</strong>
        <ul><li>API contracts</li><li>User journeys</li><li>Access control</li><li>Failure paths</li></ul>
      </div>
      <div class="system-card three">
        <div class="card-step">03 · OPERATE</div><strong>Ship with confidence</strong><p>CI gates, observable behavior, production feedback.</p>
      </div>
    </div>
  </section>

  <section class="section" id="work">
    <div class="section-heading" data-reveal>
      <span class="eyebrow">Selected systems</span>
      <div><h2>Real work, <em>deliberately engineered.</em></h2><p>A small set of projects chosen to show product thinking, software development, and a quality strategy that goes beyond happy-path automation.</p></div>
    </div>
    <div class="project-grid">
      <ProjectCard number="01" label="Product system" title="Techy" description="A live bilingual commerce experience for Apple products in Costa Rica, supported by a private repository and a public-safe engineering story." tags={['Next.js', 'TypeScript', 'Sanity']} href={`${base}projects/techy`} previewSrc={`${base}previews/techy-home.png`} previewAlt="Techy CR storefront homepage in English" featured />
      <ProjectCard number="02" label="Commerce platform" title="Galería Mexicana" description="A live retail experience connecting a searchable product catalog, cart, services, location, editorial content, and direct customer contact." tags={['Next.js', 'Supabase', 'Jest']} href={`${base}projects/galeria-mexicana`} previewSrc={`${base}previews/galeria-mexicana-home.png`} previewAlt="Galería Mexicana storefront homepage" />
      <ProjectCard number="03" label="AI product demo" title="Spanish Sentiment Lab" description="An interactive sentiment dashboard backed by a defensive Flask architecture, transparent sample data, and automated quality gates." tags={['Python', 'Flask', 'Pytest']} href={`${base}projects/spanish-sentiment-lab`} previewSrc={`${base}previews/sentiment-lab.png`} previewAlt="Spanish Sentiment Lab dashboard demo" />
    </div>
  </section>

  <section class="section" id="experience">
    <div class="section-heading" data-reveal>
      <span class="eyebrow">Work experience</span>
      <div><h2>Engineering across <em>software, quality, and operations.</em></h2><p>Progressive responsibility from cloud support and automation to production software engineering and AI-assisted quality systems.</p></div>
    </div>
    <div class="experience-list" data-reveal>
      <article class="experience-item featured-role"><time>2025 — Present</time><div><h3>Software Engineer II</h3><p class="company"><a href="https://www.datasite.com/en" target="_blank" rel="noopener">Datasite ↗</a></p><p>Java and Python document processing, AI-assisted Playwright tooling, deployment validation, and cross-system troubleshooting.</p></div></article>
      <article class="experience-item"><time>2022 — 2025</time><div><h3>QA Engineer → Associate QA Engineer</h3><p class="company"><a href="https://www.konrad.com/" target="_blank" rel="noopener">Konrad ↗</a></p><p>Automated delivery pipelines, web quality, AEM and Marketo validation, and early framework development.</p></div></article>
      <article class="experience-item"><time>2021 — 2023</time><div><h3>RPA Developer · Technical Support Engineer L3</h3><p class="company"><a href="https://lanshore.com/" target="_blank" rel="noopener">Lanshore ↗</a> · <a href="https://www.tek-experts.com/" target="_blank" rel="noopener">Tek Experts ↗</a></p><p>Enterprise automation, Azure diagnostics, technical documentation, and escalation support.</p></div></article>
    </div>
    <a class="text-link" href={`${base}experience`}>View full work experience <Icon name="arrow" /></a>
  </section>

  <section class="section impact" aria-labelledby="impact-title">
    <div class="section-heading" data-reveal>
      <span class="eyebrow">Career achievements</span>
      <div><h2 id="impact-title">Impact, <em>measured.</em></h2><p>Selected outcomes from recent engineering roles, focused on production reliability, faster validation, and more efficient delivery.</p></div>
    </div>
    <div class="impact-dashboard">
      <article class="impact-card impact-card--primary" data-reveal>
        <div class="metric-ring" role="img" aria-label="99.5 percent successful processing rate">
          <svg viewBox="0 0 120 120" aria-hidden="true"><circle class="metric-track" cx="60" cy="60" r="52" pathLength="100"></circle><circle class="metric-progress" cx="60" cy="60" r="52" pathLength="100" style="--offset: .5"></circle></svg>
          <strong>99.5%</strong>
        </div>
        <div class="impact-copy"><span>2025 — Present · Datasite</span><h3>Successful document processing</h3><p>Reliability rate for supported documents in a production Java and Python processing engine.</p></div>
      </article>
      <div class="impact-bars">
        <article class="impact-card" data-reveal style="--progress: 80%">
          <div class="impact-value"><strong>80%</strong><span>less review time</span></div>
          <div class="impact-bar" aria-hidden="true"><i></i></div>
          <p>Automated production deployment validation.</p><small>Datasite · 2025 — Present</small>
        </article>
        <article class="impact-card" data-reveal style="--progress: 45%">
          <div class="impact-value"><strong>45%</strong><span>faster validation</span></div>
          <div class="impact-bar" aria-hidden="true"><i></i></div>
          <p>Reduced Playwright test creation and validation time with an AI-assisted skill.</p><small>Datasite · 2025 — Present</small>
        </article>
        <article class="impact-card" data-reveal style="--progress: 25%">
          <div class="impact-value"><strong>25%</strong><span>delivery efficiency</span></div>
          <div class="impact-bar" aria-hidden="true"><i></i></div>
          <p>Improved delivery through automated tests in GitLab and Azure DevOps pipelines.</p><small>Konrad · 2023 — 2025</small>
        </article>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="cta-band" data-reveal>
      <span class="eyebrow">Build · Test · Deliver</span>
      <h2>Looking for an engineer who cares how software behaves in the real world?</h2>
      <p>I’m interested in software engineering and quality engineering roles where reliability, product judgment, and hands-on delivery matter.</p>
      <a class="button" href="mailto:santiagomadrizc@gmail.com">Start a conversation <Icon name="arrow" /></a>
    </div>
  </section>
</BaseLayout>
