---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
const base = import.meta.env.BASE_URL;
---
<BaseLayout title="Teaching & Credentials · Santiago Madriz" description="Teaching experience and professional certifications in software quality and artificial intelligence.">
  <header class="page-intro" data-reveal>
    <div class="eyebrow">Teaching & credentials</div>
    <h1>Learning that becomes <em>shared practice.</em></h1>
    <p>Formal software-testing certification, applied AI learning, and teaching experience focused on making technical ideas useful to others.</p>
  </header>

  <section class="credential-section" data-reveal>
    <div class="section-heading compact-heading"><span class="eyebrow">Teaching</span><div><h2>Courses and workshops.</h2></div></div>
    <div class="teaching-grid">
      <article><time>2026</time><h3>AI for Everyone</h3><p>Instructor · University of Costa Rica (UCR)</p></article>
      <article><time>2025</time><h3>Communication in Tech</h3><p>Workshop Facilitator · Technological Congress UTN</p></article>
    </div>
  </section>

  <section class="credential-section" data-reveal>
    <div class="section-heading compact-heading"><span class="eyebrow">Certifications</span><div><h2>Verified credentials.</h2></div></div>
    <div class="credential-grid">
      <article class="credential-card"><span class="credential-year">2024</span><a class="credential-preview" href={`${base}documents/ISTQB-CTFL-Santiago-Madriz.pdf`} target="_blank"><img src={`${base}previews/certificate-istqb.png`} alt="ISTQB Certified Tester Foundation Level certificate" loading="lazy" /></a><h3>Certified Tester Foundation Level (CTFL)</h3><p>ISTQB · Issued through ASTQB</p><small>Credential 24-CTFL-00323-USA</small><a href={`${base}documents/ISTQB-CTFL-Santiago-Madriz.pdf`} target="_blank">View certificate <Icon name="arrow" /></a></article>
      <article class="credential-card"><span class="credential-year">2026</span><a class="credential-preview" href={`${base}documents/Generative-AI-For-Everyone-Santiago-Madriz.pdf`} target="_blank"><img src={`${base}previews/certificate-generative-ai.png`} alt="Generative AI for Everyone course certificate" loading="lazy" /></a><h3>Generative AI for Everyone</h3><p>DeepLearning.AI · Coursera</p><small>Completed August 11, 2026</small><div class="credential-links"><a href={`${base}documents/Generative-AI-For-Everyone-Santiago-Madriz.pdf`} target="_blank">Certificate</a><a href="https://coursera.org/verify/LEJP6ASVJC9O" target="_blank" rel="noopener">Verify</a></div></article>
      <article class="credential-card"><span class="credential-year">2025</span><a class="credential-preview" href={`${base}documents/AI-For-Everyone-Santiago-Madriz.pdf`} target="_blank"><img src={`${base}previews/certificate-ai-for-everyone.png`} alt="AI For Everyone course certificate" loading="lazy" /></a><h3>AI For Everyone</h3><p>DeepLearning.AI · Coursera</p><small>Completed August 20, 2025</small><div class="credential-links"><a href={`${base}documents/AI-For-Everyone-Santiago-Madriz.pdf`} target="_blank">Certificate</a><a href="https://coursera.org/verify/G4E0LEV1FIIN" target="_blank" rel="noopener">Verify</a></div></article>
    </div>
  </section>

  <div class="page-actions" data-reveal><a class="button" href={`${base}experience`}>View work experience <Icon name="arrow" /></a></div>
</BaseLayout>
