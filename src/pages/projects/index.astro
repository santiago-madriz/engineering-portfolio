---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
const base = import.meta.env.BASE_URL;
---
<BaseLayout title="Projects · Santiago Madriz" description="Selected software and quality engineering projects by Santiago Madriz.">
  <div class="projects-page">
    <header class="page-intro" data-reveal>
      <div class="eyebrow">Projects</div>
      <h1>A focused portfolio of <em>production-minded work.</em></h1>
      <p>Each project earns its place by showing a different part of the same story: building useful software, managing risk, and shipping with confidence.</p>
    </header>
    <div class="project-grid">
      <ProjectCard number="01" label="Product system" title="Techy" description="Private-repository production platform for a real Costa Rican commerce business." tags={['Next.js', 'React', 'Sanity']} href={`${base}projects/techy`} previewSrc={`${base}previews/techy-home.png`} previewAlt="Techy CR storefront homepage in English" featured />
      <ProjectCard number="02" label="Commerce platform" title="Galería Mexicana" description="Live Mexican-products storefront with catalog discovery, cart behavior, customer contact, and editorial content." tags={['Next.js', 'Supabase', 'Jest']} href={`${base}projects/galeria-mexicana`} previewSrc={`${base}previews/galeria-mexicana-home.png`} previewAlt="Galería Mexicana storefront homepage" />
      <ProjectCard number="03" label="AI product demo" title="Spanish Sentiment Lab" description="Interactive dashboard plus a secure Flask system for API validation, data constraints, and testable analyzer boundaries." tags={['Python', 'Flask', 'Pytest']} href={`${base}projects/spanish-sentiment-lab`} previewSrc={`${base}previews/sentiment-lab.png`} previewAlt="Spanish Sentiment Lab dashboard demo" />
      <ProjectCard number="04" label="Production frontend" title="Photo & Film Portfolio" description="A real media portfolio optimized for responsive delivery, accessibility, and maintainable release confidence." tags={['HTML', 'JavaScript', 'Playwright']} href={`${base}projects/photography-platform`} previewSrc={`${base}previews/photography-home.png`} previewAlt="Santiago Madriz photography and film homepage" />
      <ProjectCard number="05" label="Quality platform" title="Playwright Quality Engineering" description="Production-style quality architecture spanning UI, API, accessibility, and delivery gates." tags={['Playwright', 'TypeScript', 'CI/CD']} href={`${base}projects/playwright-quality-engineering`} />
    </div>
  </div>
</BaseLayout>
