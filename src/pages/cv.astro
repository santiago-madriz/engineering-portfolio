---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
const base = import.meta.env.BASE_URL;
const cvPath = `${base}documents/Santiago-Madriz-CV.pdf`;
---
<BaseLayout title="CV · Santiago Madriz" description="Curriculum vitae for Santiago Madriz, Software Engineer and Quality Engineer.">
  <header class="page-intro cv-intro" data-reveal>
    <div><div class="eyebrow">Curriculum vitae</div><h1>Experience, skills, and <em>credentials.</em></h1><p>The concise one-page version of my engineering background.</p></div>
    <a class="button" href={cvPath} download>Download PDF <Icon name="arrow" /></a>
  </header>
  <section class="document-shell" data-reveal>
    <a href={cvPath} target="_blank" aria-label="Open Santiago Madriz CV as a PDF">
      <img src={`${base}previews/cv-preview.png`} alt="Preview of Santiago Madriz's one-page curriculum vitae" />
    </a>
  </section>
</BaseLayout>
