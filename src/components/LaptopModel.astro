---
const base = import.meta.env.BASE_URL;
---

<div class="laptop-scene" data-laptop-model data-model-url={`${base}models/macbookpro.fbx`} data-rotation="0">
  <div class="laptop-halo"></div>
  <canvas role="img" aria-label="Interactive 3D laptop rotating through a full turn while scrolling"></canvas>
  <img class="laptop-fallback" src={`${base}visuals/code-laptop.png`} alt="Black laptop displaying colorful Playwright and TypeScript test code" width="1536" height="1024" loading="eager" fetchpriority="high" />
  <span class="laptop-caption">360° · Scroll to rotate</span>
</div>

<script>
  import * as THREE from 'three';
  import { FBXLoader } from 'three/examples/jsm/loaders/FBXLoader.js';

  const clamp = (value: number) => Math.min(1, Math.max(0, value));

  const createCodeTexture = () => {
    const canvas = document.createElement('canvas');
    canvas.width = 1200;
    canvas.height = 720;
    const context = canvas.getContext('2d');
    if (!context) return null;

    context.fillStyle = '#05070b';
    context.fillRect(0, 0, canvas.width, canvas.height);
    const gradient = context.createLinearGradient(0, 0, canvas.width, canvas.height);
    gradient.addColorStop(0, 'rgba(63,111,159,.18)');
    gradient.addColorStop(1, 'rgba(0,0,0,0)');
    context.fillStyle = gradient;
    context.fillRect(0, 0, canvas.width, canvas.height);

    context.font = '28px ui-monospace, SFMono-Regular, Menlo, monospace';
    const lines = [
      ['#8fb3d4', "import { test, expect } from '@playwright/test';"],
      ['#87909a', "test.describe('release confidence', () => {"],
      ['#d7b26d', "  test('protects the customer journey', async ({ page }) => {"],
      ['#8fb3d4', "    await page.goto('/');"],
      ['#ad82c4', "    await expect(page.getByRole('main')).toBeVisible();"],
      ['#76a889', "    await expect(page).toHaveTitle(/Santiago Madriz/);"],
      ['#87909a', '  });'],
      ['#87909a', '});'],
      ['#d7b26d', ''],
      ['#8fb3d4', 'const quality = {'],
      ['#76a889', "  architecture: 'testable',"],
      ['#76a889', "  delivery: 'observable',"],
      ['#76a889', "  experience: 'reliable'"],
      ['#8fb3d4', '};']
    ];
    lines.forEach(([color, line], index) => {
      context.fillStyle = color;
      context.fillText(line, 52, 72 + index * 43);
    });

    const texture = new THREE.CanvasTexture(canvas);
    texture.colorSpace = THREE.SRGBColorSpace;
    texture.anisotropy = 4;
    return texture;
  };

  document.querySelectorAll<HTMLElement>('[data-laptop-model]').forEach((root) => {
    const canvas = root.querySelector<HTMLCanvasElement>('canvas');
    const modelUrl = root.dataset.modelUrl;
    if (!canvas || !modelUrl) return;

    let renderer: THREE.WebGLRenderer;
    try {
      renderer = new THREE.WebGLRenderer({ canvas, alpha: true, antialias: true, powerPreference: 'high-performance' });
    } catch {
      root.classList.add('model-unavailable');
      return;
    }

    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 1.5));
    renderer.outputColorSpace = THREE.SRGBColorSpace;
    renderer.toneMapping = THREE.ACESFilmicToneMapping;
    renderer.toneMappingExposure = 1.15;

    const scene = new THREE.Scene();
    const camera = new THREE.PerspectiveCamera(28, 1, .1, 100);
    camera.position.set(0, .72, 4.4);
    camera.lookAt(0, 0, 0);

    scene.add(new THREE.HemisphereLight(0xdde7f0, 0x10151c, 2.2));
    const key = new THREE.DirectionalLight(0xffffff, 3.2);
    key.position.set(3, 4, 5);
    scene.add(key);
    const rim = new THREE.DirectionalLight(0x4f83b6, 2.4);
    rim.position.set(-4, 2, -3);
    scene.add(rim);

    const pivot = new THREE.Group();
    pivot.rotation.x = -.13;
    scene.add(pivot);
    const initialRotation = -.55;
    let currentRotation = initialRotation;
    let targetRotation = initialRotation;
    let frame = 0;
    let modelLoaded = false;

    const queueRender = () => {
      if (!frame) frame = window.requestAnimationFrame(renderFrame);
    };

    const renderFrame = () => {
      frame = 0;
      currentRotation += (targetRotation - currentRotation) * .12;
      pivot.rotation.y = currentRotation;
      renderer.render(scene, camera);
      if (Math.abs(targetRotation - currentRotation) > .001) queueRender();
    };

    const materialFor = (name: string, screenTexture: THREE.Texture | null) => {
      if (name === 'Material.008' && screenTexture) {
        return new THREE.MeshBasicMaterial({
          map: screenTexture,
          toneMapped: false,
          side: THREE.DoubleSide,
          depthTest: false,
          depthWrite: false
        });
      }
      const lightMetal = ['Material.003', 'Material.005', 'Material.010'].includes(name);
      const midMetal = ['Material.002', 'Material.016'].includes(name);
      return new THREE.MeshStandardMaterial({
        color: lightMetal ? 0x777b82 : midMetal ? 0xb7bac0 : 0x090b0e,
        metalness: lightMetal || midMetal ? .82 : .28,
        roughness: lightMetal || midMetal ? .27 : .5
      });
    };

    new FBXLoader().load(modelUrl, (model) => {
      const screenTexture = createCodeTexture();
      model.traverse((child) => {
        if (!(child instanceof THREE.Mesh)) return;
        const sourceMaterials = Array.isArray(child.material) ? child.material : [child.material];
        const materials = sourceMaterials.map((material) => materialFor(material.name, screenTexture));
        child.material = Array.isArray(child.material) ? materials : materials[0];
        if (sourceMaterials.some((material) => material.name === 'Material.008')) child.renderOrder = 10;
        child.castShadow = false;
        child.receiveShadow = false;
      });

      const box = new THREE.Box3().setFromObject(model);
      const size = box.getSize(new THREE.Vector3());
      const center = box.getCenter(new THREE.Vector3());
      const scale = 2.65 / Math.max(size.x, size.y, size.z);
      const normalizedModel = new THREE.Group();
      normalizedModel.add(model);
      normalizedModel.scale.setScalar(scale);
      normalizedModel.position.copy(center).multiplyScalar(-scale);
      pivot.add(normalizedModel);
      modelLoaded = true;
      root.classList.add('model-loaded');
      queueRender();
    }, undefined, () => root.classList.add('model-unavailable'));

    const updateRotation = () => {
      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      let progress = 0;
      if (!reducedMotion) {
        if (window.innerWidth <= 620) {
          const rect = root.getBoundingClientRect();
          progress = clamp((window.innerHeight - rect.top) / (window.innerHeight + rect.height));
        } else {
          const range = Math.max(480, root.closest('.hero')?.clientHeight ?? 0);
          progress = clamp(window.scrollY / range);
        }
      }
      targetRotation = initialRotation + progress * Math.PI * 2;
      root.dataset.rotation = String(Math.round(progress * 360));
      if (modelLoaded) queueRender();
    };

    const resize = () => {
      const width = Math.max(1, root.clientWidth);
      const height = Math.max(1, canvas.clientHeight);
      renderer.setSize(width, height, false);
      camera.aspect = width / height;
      camera.updateProjectionMatrix();
      updateRotation();
      queueRender();
    };

    new ResizeObserver(resize).observe(root);
    window.addEventListener('scroll', updateRotation, { passive: true });
    window.addEventListener('resize', resize, { passive: true });
    updateRotation();
    resize();
  });
</script>
