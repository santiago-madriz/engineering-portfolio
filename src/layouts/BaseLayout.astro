---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}
const {
  title = 'Santiago Madriz · Software Engineer & Quality Engineer',
  description = 'Software Engineer with Quality Engineering expertise, building reliable, well-tested production systems.'
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const base = import.meta.env.BASE_URL;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#050505" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="ambient-motion" aria-hidden="true"><i class="ambient-orb ambient-orb--one"></i><i class="ambient-orb ambient-orb--two"></i><i class="ambient-orb ambient-orb--three"></i></div>
    <div class="page-shell">
      <Header />
      <main id="main"><slot /></main>
      <Footer />
    </div>
    <script>
      const entranceSelector = [
        '.site-header .brand', '.site-header nav a', '.header-cta',
        'main h1', 'main h2', 'main h3', 'main p', 'main .eyebrow', 'main .section-kicker',
        'main .button', 'main .text-link', 'main .hero-proof li',
        'main .laptop-scene', 'main .system-card', 'main .system-card > *',
        'main .connector', 'main .connector-dot',
        'main .project-card', 'main .project-card > *', 'main .project-card li', 'main .project-preview img',
        'main .experience-item', 'main .experience-item > *',
        'main .career-role', 'main .career-role > *',
        'main .impact-card', 'main .impact-card > *',
        'main .case-link', 'main .teaching-grid article', 'main .teaching-grid article > *',
        'main .credential-card', 'main .credential-card > *', 'main .credential-preview img',
        'main .page-actions > *', 'main .cta-band > *', 'footer > *'
      ].join(',');
      const entranceElements = [...document.querySelectorAll<HTMLElement>(entranceSelector)];

      document.documentElement.classList.add('motion-enabled');
      entranceElements.forEach((element, index) => {
        element.dataset.enter = '';
        element.style.setProperty('--enter-delay', `${(index % 7) * 48}ms`);
      });

      const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('entered');
            observer.unobserve(entry.target);
          }
        });
      }, { threshold: 0.08, rootMargin: '0px 0px -3% 0px' });

      entranceElements.forEach((element) => observer.observe(element));
    </script>
  </body>
</html>
